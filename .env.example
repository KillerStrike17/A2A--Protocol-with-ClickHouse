# Copy this file to .env and fill in GOOGLE_API_KEY.

# --- Gemini ---
GOOGLE_API_KEY=your_gemini_api_key       # https://aistudio.google.com/apikey
GOOGLE_GENAI_USE_VERTEXAI=FALSE          # TRUE to use Vertex AI instead of an API key
GEMINI_MODEL=gemini-3.8-flash            # model used by all agents
MOVIE_AGENT_MODEL=                       # optional; overrides GEMINI_MODEL for the Movie Agent only

# --- ClickHouse: public SQL playground (IMDB preloaded, read-only, no password) ---
CLICKHOUSE_HOST=sql-clickhouse.clickhouse.com
CLICKHOUSE_PORT=443
CLICKHOUSE_USERNAME=demo
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=imdb
CLICKHOUSE_SECURE=true

# --- ClickHouse: your own Cloud service (uncomment, then run clickhouse/load_imdb.py) ---
# CLICKHOUSE_HOST=<id>.<region>.<provider>.clickhouse.cloud
# CLICKHOUSE_PORT=8443
# CLICKHOUSE_USERNAME=default
# CLICKHOUSE_PASSWORD=your_password
# CLICKHOUSE_DATABASE=imdb
# CLICKHOUSE_SECURE=true

# --- Optional ---
MOVIE_MIN_CAST_SIZE=30                   # min credited cast for genre/year recommendations
HOST_OVERRIDE=                           # override the Sushmita Agent card URL
